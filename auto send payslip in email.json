{
  "name": "Hamdan Portal: Auto-Send Payslip Email (Polling)",
  "nodes": [
    {
      "id": "03c997fb-cccc-468c-b896-acb0e863696d",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] } }
    },
    {
      "id": "4a5d3fcb-b18e-47c5-aacb-9f426bacfe80",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [224, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "supabase-url", "name": "supabaseUrl", "value": "https://msoomcjzzudibiyezclj.supabase.co", "type": "string" },
            { "id": "bucket", "name": "bucket", "value": "payslips", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3e85be42-5da6-4324-8145-da59fee6d481",
      "name": "Fetch Recent Payslips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [448, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.supabaseUrl }}/rest/v1/payslips?select=user_id,cutoff_label,cutoff_period,file_path,file_name,uploaded_at&order=uploaded_at.desc&limit=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      }
    },
    {
      "id": "504852a3-ffc3-417b-88d3-13b79041886a",
      "name": "Not Yet Emailed?",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [672, 0],
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "payslip_emails_sent" },
        "matchType": "allConditions",
        "filters": { "conditions": [{ "keyName": "file_path", "condition": "eq", "keyValue": "={{ $json.file_path }}" }] }
      }
    },
    {
      "id": "2c76e4c2-8033-46a8-b526-d52fd0c51027",
      "name": "Get Employee Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [896, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.supabaseUrl }}/rest/v1/profiles?id=eq.{{ $('Not Yet Emailed?').item.json.user_id }}&select=employee_email,full_name,employee_id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      }
    },
    {
      "id": "d0739108-c369-4507-83ef-56d0f81e7275",
      "name": "Download Payslip PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.supabaseUrl }}/storage/v1/object/{{ $('Config').item.json.bucket }}/{{ $('Not Yet Emailed?').item.json.file_path }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      }
    },
    {
      "id": "915967ce-3aa6-4ec7-89e1-a4a4366ed749",
      "name": "Set Attachment Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst fileName = $('Not Yet Emailed?').item.json.file_name;\nif (item.binary && item.binary.data) {\n  item.binary.data.fileName = fileName;\n}\nreturn item;"
      }
    },
    {
      "id": "4972b172-9ca9-4a42-8a50-2ae327c07bcd",
      "name": "Send Payslip Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1568, 0],
      "parameters": {
        "fromEmail": "jcramos@hamdanstudiomanila.com",
        "toEmail": "={{ $('Get Employee Email').item.json.employee_email }}",
        "subject": "=Your Payslip is Ready — {{ $('Not Yet Emailed?').item.json.cutoff_label }}",
        "html": "=<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:0;background-color:#f4f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f4f4f7;padding:24px 0;\"><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);\"><tr><td style=\"background-color:#16a34a;padding:28px 32px;\"><div style=\"font-size:13px;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,0.85);font-weight:600;\">Hamdan Engineering · Employee Portal</div><div style=\"font-size:24px;color:#ffffff;font-weight:700;margin-top:6px;\">📄 Your Payslip is Ready</div></td></tr><tr><td style=\"padding:28px 32px 8px 32px;\"><p style=\"margin:0;font-size:15px;color:#374151;line-height:1.6;\">Hi {{ $('Get Employee Email').item.json.full_name }}! Available na ang iyong payslip para sa <strong>{{ $('Not Yet Emailed?').item.json.cutoff_label }}</strong>. Nakalakip (attached) ang PDF copy sa email na ito.</p></td></tr><tr><td style=\"padding:16px 32px 8px 32px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:13px;color:#6b7280;width:160px;\">Cutoff Period</td><td style=\"padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:14px;color:#111827;font-weight:600;\">{{ $('Not Yet Emailed?').item.json.cutoff_label }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:13px;color:#6b7280;\">File</td><td style=\"padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:14px;color:#111827;\">{{ $('Not Yet Emailed?').item.json.file_name }}</td></tr><tr><td style=\"padding:10px 0;font-size:13px;color:#6b7280;\">Released On</td><td style=\"padding:10px 0;font-size:14px;color:#111827;\">{{ $('Not Yet Emailed?').item.json.uploaded_at }}</td></tr></table></td></tr><tr><td style=\"padding:20px 32px 8px 32px;\"><p style=\"margin:0;font-size:13px;color:#6b7280;line-height:1.6;\">Para sa anumang katanungan o dispute tungkol sa iyong payslip, mangyaring makipag-ugnayan sa HR o gamitin ang <strong>My Disputes</strong> sa Employee Portal.</p></td></tr><tr><td style=\"background-color:#f9fafb;padding:20px 32px;border-top:1px solid #f0f0f0;\"><p style=\"margin:0;font-size:12px;color:#9ca3af;line-height:1.5;\">Confidential — para lamang sa nakatakdang tatanggap. Automated na mensahe mula sa Hamdan Engineering Employee Portal.</p></td></tr></table></td></tr></table></body></html>",
        "options": { "attachments": "data", "appendAttribution": false }
      }
    },
    {
      "id": "539a31a8-cb92-47b0-be50-98ab08cc141c",
      "name": "Mark Emailed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1792, 0],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "payslip_emails_sent" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "file_path": "={{ $('Not Yet Emailed?').item.json.file_path }}",
            "user_id": "={{ $('Not Yet Emailed?').item.json.user_id }}",
            "cutoff_period": "={{ $('Not Yet Emailed?').item.json.cutoff_period }}",
            "emailed_at": "={{ $now.toISO() }}"
          },
          "schema": [
            { "id": "file_path", "displayName": "file_path", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "user_id", "displayName": "user_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "cutoff_period", "displayName": "cutoff_period", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "emailed_at", "displayName": "emailed_at", "required": false, "defaultMatch": false, "display": true, "type": "dateTime", "canBeUsedToMatch": false }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 10 Minutes": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Fetch Recent Payslips", "type": "main", "index": 0 }]] },
    "Fetch Recent Payslips": { "main": [[{ "node": "Not Yet Emailed?", "type": "main", "index": 0 }]] },
    "Not Yet Emailed?": { "main": [[{ "node": "Get Employee Email", "type": "main", "index": 0 }]] },
    "Get Employee Email": { "main": [[{ "node": "Download Payslip PDF", "type": "main", "index": 0 }]] },
    "Download Payslip PDF": { "main": [[{ "node": "Set Attachment Name", "type": "main", "index": 0 }]] },
    "Set Attachment Name": { "main": [[{ "node": "Send Payslip Email", "type": "main", "index": 0 }]] },
    "Send Payslip Email": { "main": [[{ "node": "Mark Emailed", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "binaryMode": "separate" }
}