+-- Audit table: authenticated users may only read (RLS policies scope the rows).
+-- All writes go through the SECURITY DEFINER RPCs (adjust_manpower_time,
+-- transfer_manpower_time), which run as the function owner.
+revoke all on table public.manpower_time_adjustments from public, anon, authenticated;
+grant select on table public.manpower_time_adjustments to authenticated;
+grant all on table public.manpower_time_adjustments to service_role;
+
+-- Trigger functions are never called directly; they do not need EXECUTE for
+-- API roles. Triggers keep firing because privileges are not checked at fire time.
+revoke execute on function public.add_approved_offset_manpower() from public, anon, authenticated;
+revoke execute on function public.capture_offset_manpower_context() from public, anon, authenticated;
